{
	"name": "eckwerkstuttgart",
	"private": true,
	"type": "module",
	"version": "1.0.0",
	"packageManager": "pnpm@10.34.5",
	"scripts": {
		"dev": "astro dev",
		"build": "astro check && astro build --mode=prod",
		"check": "astro check",
		"preview": "astro preview",
		"astro": "astro",
		"lint": "eslint \"src/**/*.{js,ts,jsx,tsx,astro}\"",
		"lint:fix": "eslint --fix \"src/**/*.{js,ts,jsx,tsx,astro}\"",
		"format": "prettier --write \"**/*.{js,mjs,ts,md,mdx,astro,json,yaml,yml}\"",
		"format:check": "prettier --check \"**/*.{js,mjs,ts,md,mdx,astro,json,yaml,yml}\""
	},
	"dependencies": {
		"@astrojs/check": "^0.9.10",
		"@astrojs/mdx": "8.0.2",
		"@astrojs/sitemap": "3.7.4",
		"@astrojs/tailwind": "^6.0.2",
		"@fontsource-variable/montserrat": "^5.3.0",
		"@fontsource-variable/source-code-pro": "^5.3.0",
		"@fontsource-variable/source-sans-3": "^5.3.0",
		"@iconify-json/line-md": "^1.2.16",
		"astro": "^7.3.5",
		"astro-icon": "^1.2.0",
		"astro-webmanifest": "^1.0.0",
		"gsap": "^3.15.0",
		"photoswipe": "^5.4.4",
		"sharp": "0.35.4",
		"tailwindcss": "^3.4.19",
		"typescript": "^5.9.3",
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"autoprefixer": "^10.6.1",
		"eslint": "^10.11.0",
		"eslint-plugin-astro": "^3.2.1",
		"globals": "^17.12.0",
		"prettier": "^3.9.9",
		"prettier-plugin-astro": "^1.1.0",
		"prettier-plugin-packagejson": "^3.0.2",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"typescript-eslint": "^8.70.1"
	},
	"volta": {
		"node": "22.22.3"
	}
