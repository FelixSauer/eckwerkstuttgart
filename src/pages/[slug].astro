---
import { getCollection, render } from 'astro:content'
import SectionContent from '@/components/SectionContent.astro'
import Layout from '@/layouts/multi.astro'

export async function getStaticPaths() {
	const pages = await getCollection('pages')

	return pages
		.filter((page) => page.data.navigation.includes('Footer'))
		.map((page) => ({
			params: { slug: page.data.title },
			props: { page }
		}))
}

const { page } = Astro.props
const { Content } = await render(page)
---

<Layout title={page.data.title} footerAtBottom>
	<SectionContent id={page.data.title} animate={false}>
		<Content />
	</SectionContent>
</Layout>
