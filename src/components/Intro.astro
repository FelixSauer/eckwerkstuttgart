---
import introDesktop from '../assets/Albums/Intro/IntroImage.jpeg'
import introMobile from '../assets/Albums/Intro/IntroImage-mobil.jpg'

interface Props {
	title?: string
}

const { title } = Astro.props
---

<section class="relative w-full scroll-m-28 bg-white">
	<div class="h-auto md:h-full">
		<picture>
			<source media="(max-width: 767px)" srcset={introMobile.src} />
			<source media="(min-width: 768px)" srcset={introDesktop.src} />
			<img
				src={introMobile.src}
				alt="Intro Image"
				class="h-full w-full object-cover"
			/>
		</picture>
	</div>

	<div class="absolute inset-0 flex items-center justify-center break-normal break-keep tracking-tight lg:tracking-tight">
		<h1
			id="intro-title"
			class="2xl:text-9xs pb-36 text-center text-4xl text-white opacity-0 sm:pb-56 sm:text-6xl md:pb-64 md:text-6xl lg:pb-96 lg:text-7xl xl:break-words xl:pl-9 xl:pr-9 xl:text-9xl 2xl:pb-96 2xl:pl-9 2xl:pr-9"
		>
			{title}
		</h1>
	</div>
</section>

<script>
	import { fadeIn } from '../utils/Animations'

	document.addEventListener('DOMContentLoaded', () => {
		fadeIn(document.getElementById('intro-title'), 0, 1.5)
	})
</script>
